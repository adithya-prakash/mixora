# Render.com / Railway production environment variables
# Copy these into the platform dashboard (do NOT commit real secrets to git)

# Set this to your Vercel frontend URL after deploying
ALLOWED_ORIGINS=https://YOUR-APP.vercel.app

# Conservative limits for free-tier hosting (512 MB – 1 GB RAM)
MAX_UPLOAD_MB=50
MAX_DURATION_S=600
MAX_CONCURRENT_ANALYSES=1
RATE_LIMIT_PER_MINUTE=30

# Persistent disk (Render: add a disk mounted at /data)
DB_URL=sqlite:////data/mixora.sqlite3
STORAGE_DIR=/data

RETENTION_DAYS=30
FFMPEG_BIN=ffmpeg
